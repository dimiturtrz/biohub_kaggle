# Python bytecode / build
__pycache__/
*.pyc
*.egg-info/

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.grimp_cache/

# archmap: graph.json IS committed (the diffable architecture artifact); the interactive viewer shell is
# regenerated (template-identical, ~700KB of vendored libs) locally / in the Pages workflow — not committed.
docs/architecture/index.html

# Virtualenv
.venv/

# Logs / local DBs — anchored to root (`/logs/`, not `logs/`, so a source dir named logs/ isn't ignored)
/logs/
*.db

# External git-repo deps: checked out under external/, never vendored. Anchored — a package may
# legitimately have an `external/` submodule.
/external/

# Coverage artifacts
.coverage*
coverage.xml
htmlcov/

# Private/local-only docs (generic pattern — reveals no intent in the ignore list itself)
*.local.md

# ML workflow: data lives OUTSIDE the repo (paths.yaml points at it), MLflow tracking, training runs.
# Anchored to root (`/data/`, not `data/`) so a source package like core/data/ isn't silently
# untracked, hiding its tests (bd hhy).
/data/
/paths.yaml
/runs/
/mlruns/

# Beads / Dolt engine bits (issues.jsonl is tracked; the embedded engine is not)
.dolt/
.beads/*.db
.beads-credential-key
# bd points core.hooksPath at .beads/hooks, so `pre-commit install` writes its generated shims there.
# Those two carry an absolute uv-cache interpreter path, so they are per-machine: regenerate them with
# `pre-commit install --hook-type pre-commit --hook-type pre-push`. bd's own hooks stay tracked.
.beads/hooks/pre-commit
.beads/hooks/pre-push

# jscpd (node) — pulled transiently by npx for the duplication gate
node_modules/

# Isolated venv holding the organizers' package, used only to regenerate metric fixtures.
/.oracle/

# Transient tool output from local gate runs.
*.log
/scratchpad/

/kaggle/kit/
/kaggle/kit_staging/
kaggle/**/*.pt
# Vendored third-party CC0 dataset weights (pilkwang association ranker, 20KB, not reproducible in-repo).
!kaggle/datasets/**/*.pt
kaggle/**/*.whl
# Kernel run outputs (submission.csv etc are reproducible artifacts, never committed).
kaggle/kernels/**/out/
# Kaggle kernel notebooks are generated submit artifacts (repo policy: no .ipynb in git).
kaggle/kernels/**/*.ipynb
.venv-repro/

# Scratch experiment output — underscore-prefixed local scratch dirs, nohup logs, ad-hoc out dirs.
kaggle/_*/
*.nohup
/scratchpad_kaggle_out/

# Organizers' reference scorer repo — external checkout, read for the metric, never vendored.
/scratchpad_kout/

# ephemeral agent worktrees (isolated; not part of tracked tree)
.claude/worktrees/
# Per-machine agent settings: absolute working-directory paths, never portable.
.claude/settings.local.json

# Cross-agent mailbox: inbox/ dir is tracked (.gitkeep), the dropped messages are transient.
/inbox/*
!/inbox/.gitkeep
research/frontier_kernels/*/output/

# Donor kernels are OTHER COMPETITORS' published notebooks, pulled locally to read. Their Kaggle
# metadata carries no licence field, so none of them may be assumed permissive and none is
# redistributed here. research/frontier_kernels/README.md is the manifest (owner, slug, fetch
# command); everything it points at is fetched, never vendored.
research/frontier_kernels/*/
!research/frontier_kernels/README.md
!research/frontier_kernels/SYNTHESIS_*.md
!research/frontier_kernels/_donor_weights/
research/frontier_kernels/_donor_weights/*
!research/frontier_kernels/_donor_weights/*.json

# Our own predictions over the competition test set — a reproducible pipeline output.
/submission.csv
# Corrupt MLflow store, kept on disk only in case a run id is ever needed again.
/mlflow.db*
